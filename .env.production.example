# Copy this to .env.production on the EC2 instance (same directory as the
# cloned repo) and fill in real values. .env.production is gitignored —
# never commit it. Both systemd services load it via EnvironmentFile=.

# --- NextAuth ---
# Explicit canonical URL — `trustHost: true` in src/auth.ts is a fallback,
# but with a fixed known domain, setting this directly is more reliable
# than header-based auto-detection through the reverse proxy.
AUTH_URL=https://yourname.duckdns.org
AUTH_SECRET=

# --- Gmail SMTP (OTP / password-reset / notification emails) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Admin panel ---
ADMIN_EMAILS=

# --- Gemini (vision analysis) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional — comma-separated, tried in order if GEMINI_MODEL is
# overloaded/rejected. Defaults set in vision_engine.py if left unset.
# GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.6-flash

# --- Database ---
# Left unset on purpose: the app uses a local SQLite file at data/app.db,
# same as local dev. Only set these if you decide to use a hosted Turso
# database instead.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Note: the DuckDNS domain isn't set here — it's written directly into
# /etc/caddy/Caddyfile on the instance instead (see DEPLOY.md).
